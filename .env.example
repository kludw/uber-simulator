# Copy to .env. Matches compose.yaml ports.
NATS_URL=nats://localhost:4222
NATS_WS_URL=ws://localhost:9222
# ClickHouse: compose.yaml creates this user and database from the same values.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=sim
CLICKHOUSE_PASSWORD=sim
CLICKHOUSE_DB=sim
# UI server (bun run ui): optional, default 3000.
# UI_PORT=3000
# Service processes (bun run dev): optional, defaults in README.
# RUN_ID: set by bun run dev (fresh per start); set it only to run a service entrypoint directly.
# RUN_ID=my-run-1
# SEED=1
# SPEED=1
# CLOCK_START_DELAY_MS=2000
# DRIVER_SHARDS=2
# DRIVERS_PER_SHARD=50
# REQUESTS_PER_MINUTE=10
# Rider demand model: uniform | city (ADR 0031).
# DEMAND=uniform
# Driver shifts: off | on (ADR 0032).
# SHIFTS=off
# Driver preferences: off | picky (ADR 0035).
# PREFERENCES=off
# Dispatch matching strategy: greedy | batched (ADR 0030); window in ticks, batched only.
# MATCHING=greedy
# BATCH_WINDOW_TICKS=5
# Region layout, one dispatch process per region: <columns>x<rows> (ADR 0050).
# REGIONS=1x1
# REGION_INDEX: set by bun run dev per dispatch; set it only to run src/dispatch/main.ts directly.
# REGION_INDEX=0
# Surge pricing: off | on (ADR 0054). bun run ui reads REGIONS too, to draw surge zones per region.
# SURGE=off
# Ride pooling: off | on (ADR 0056). Riders only.
# POOLING=off
